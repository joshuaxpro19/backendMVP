# URL pública del backend (backendMVP).
# Para la demo con Cloudflare Tunnel, pega aquí la URL que imprime el túnel.
# Ejemplo: https://algo-random.trycloudflare.com
EXPO_PUBLIC_API_URL=https://algo-random.trycloudflare.com

# Alternativas:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000   (misma red WiFi)
# EXPO_PUBLIC_API_URL=http://localhost:8000      (solo simulador/emulador)
