# Application
APP_NAME=API Vecinal
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mvp_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL (used by SQLAlchemy)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/mvp_db

# Fuentes externas (opcionales; estos son los valores por defecto)
INDECI_URL=https://portal.indeci.gob.pe/informe/informe-de-peligros/
OVERPASS_URL=https://overpass-api.de/api/interpreter
HTTP_TIMEOUT_SECONDS=45
OSM_TIMEOUT_SECONDS=90
