# Application
APP_NAME=API Vecinal
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mvp_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL (used by SQLAlchemy)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/mvp_db

# Facebook scraping (Playwright)
# Usa una cuenta descartable: automatizar Facebook puede restringirla.
FB_EMAIL=
FB_PASSWORD=
FB_STATE_PATH=data/fb_state.json
SCRAPING_HEADLESS=true
SCRAPING_CITY=Piura
SCRAPING_IMAGES_DIR=data/scraping_images
SCRAPING_MAX_IMAGES=60

# Revisión de leads de Facebook con IA (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Automatización: scrapear cada N horas y limpiar con IA
AUTOMATIZACION=true
SCRAPE_CADA_HORAS=6
IA_AUTO=true
IA_LOTE=12
